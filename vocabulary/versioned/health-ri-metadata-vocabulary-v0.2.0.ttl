<https://w3id.org/health-ri/metadata-vocabulary> a owl:Ontology ;
    dcterms:title "Health-RI Metadata Vocabulary"@en ;
    rdfs:label "Health-RI Metadata Vocabulary"@en ;
    dcterms:abstract "A vocabulary defining Health-RI-specific metadata terms for health dataset discovery, providing properties for dataset-level health conditions of interest and anatomical locations covered."@en ;
    dcterms:identifier "https://w3id.org/health-ri/metadata-vocabulary"^^xsd:anyURI ;
    dcat:landingPage <https://w3id.org/health-ri/metadata-vocabulary/spec> ;
    foaf:logo <https://raw.githubusercontent.com/Health-RI/semantic-interoperability/refs/heads/main/docs/assets/images/health-ri-logo-blue.png> ;
    mod:repository <https://w3id.org/health-ri/metadata-vocabulary/git> ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    dcterms:description "A vocabulary of Health-RI-specific terms for describing health datasets at metadata and catalogue level. It complements reused metadata standards; it is not a complete metadata schema or a clinical terminology."@en ;
    dcterms:creator <https://orcid.org/0009-0002-3089-9558>,
        <https://orcid.org/0000-0001-8306-0380>,
        <https://orcid.org/0000-0003-0771-3516>,
        <https://orcid.org/0000-0003-2736-7817> ;
    dcterms:contributor <https://orcid.org/0009-0002-3089-9558>,
        <https://orcid.org/0000-0001-8306-0380>,
        <https://orcid.org/0000-0003-0771-3516>,
        <https://orcid.org/0000-0003-2736-7817> ;
    dcterms:publisher <https://w3id.org/health-ri> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:language "en"^^xsd:language ;
    dcterms:issued "2026-09-30"^^xsd:date ;
    dcterms:modified "2026-10-01"^^xsd:date ;
    owl:priorVersion <https://w3id.org/health-ri/metadata-vocabulary/v0.1.0> ;
    owl:versionInfo "0.2.0" ;
    dcat:version "0.2.0" ;
    owl:versionIRI <https://w3id.org/health-ri/metadata-vocabulary/v0.2.0> ;
    vann:preferredNamespacePrefix "hri" ;
    vann:preferredNamespaceUri "https://w3id.org/health-ri/metadata-vocabulary#"^^xsd:anyURI ;
    foaf:homepage <https://health-ri.github.io/health-ri-metadata-vocabulary/> ;
    rdfs:seeAlso <https://w3id.org/health-ri/metadata-vocabulary/v0.2.0/spec> ;
    schema:codeRepository <https://github.com/Health-RI/health-ri-metadata-vocabulary> ;
    dcat:keyword "health metadata"@en, "dataset discovery"@en, "Semantic Web vocabulary"@en ;
    dcterms:bibliographicCitation "Konrad, A.; Neikes, H.; van Ulzen, N.; Barcelos, P. P. F. (2026). Health-RI Metadata Vocabulary, version 0.2.0. https://w3id.org/health-ri/metadata-vocabulary/v0.2.0"@en ;
    rdfs:comment "Development release for review. The entire vocabulary is versioned together using Semantic Versioning; term IRIs remain unversioned. This release does not assert approval or adoption by a particular Health-RI Metadata Schema release."@en .

<https://w3id.org/health-ri> a foaf:Organization ;
    foaf:name "Health-RI" ;
    foaf:homepage <https://www.health-ri.nl/> .

hri:healthConditionOfInterest a owl:ObjectProperty ;
    rdfs:label "health condition of interest"@en ;
    skos:definition "Relates a dataset to an identified concept representing a disease, disorder, or clinical condition that the dataset as a whole concerns at metadata or catalogue level."@en ;
    rdfs:comment "The value represents a clinical concept, not a patient or an individual occurrence of a condition. Multiple values may be provided. Values must be IRIs; this syntactic requirement is expressed in the accompanying SHACL shape, not by an RDFS range of IRI."@en ;
    skos:scopeNote "This relation characterises the dataset as a whole. It does not assert that individual subjects, patients, records, samples, or observations have been diagnosed with the condition, and it is not an enumeration of diagnoses in individual records. Use externally identified disease or condition concepts from appropriate terminologies or classifications. The vocabulary does not prescribe a closed list of terminologies. Values are modelled as skos:Concept in accordance with the Health-RI metadata convention."@en ;
    skos:historyNote "Introduced for the health condition of interest requirement (R-U-04). It replaces the previously proposed use of SIO_000332 in the modelling decision. This history does not assert equivalence, subsumption, or a formal mapping to SIO."@en ;
    skos:example "A dataset concerning myocardial infarction may link to http://snomed.info/id/22298006; the linked concept is typed as skos:Concept in the metadata graph. This says nothing about diagnosis status of individual participants."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/health-ri/metadata-vocabulary> .

<https://orcid.org/0009-0002-3089-9558> a foaf:Person ;
