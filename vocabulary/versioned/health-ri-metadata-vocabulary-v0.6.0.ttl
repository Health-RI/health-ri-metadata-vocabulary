@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix hri: <https://w3id.org/health-ri/metadata-vocabulary#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sct: <http://snomed.info/id/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/health-ri/metadata-vocabulary> a owl:Ontology ;
    vann:example <https://w3id.org/health-ri/metadata-vocabulary/example/health-condition-of-interest>,
        <https://w3id.org/health-ri/metadata-vocabulary/example/anatomical-location-covered> ;
    sh:suggestedShapesGraph <https://w3id.org/health-ri/metadata-vocabulary/shacl> ;
    dcterms:title "Health-RI Metadata Vocabulary"@en ;
    rdfs:label "Health-RI Metadata Vocabulary"@en ;
    dcterms:abstract "An RDF vocabulary defining terms for describing and discovering health datasets. It is intended for use in the Health-RI Metadata Schema alongside terms reused from established metadata standards and external vocabularies."@en ;
    dcterms:identifier "https://w3id.org/health-ri/metadata-vocabulary"^^xsd:anyURI ;
    dcat:landingPage <https://w3id.org/health-ri/metadata-vocabulary/spec> ;
    foaf:logo <https://raw.githubusercontent.com/Health-RI/semantic-interoperability/refs/heads/main/docs/assets/images/health-ri-logo-blue.png> ;
    mod:repository <https://w3id.org/health-ri/metadata-vocabulary/git> ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    dcterms:description "The Health-RI Metadata Vocabulary defines reusable terms for expressing aspects of health dataset metadata. Each term has a persistent identifier and a documented meaning, supported by RDF/OWL definitions. Usage examples and accompanying SHACL shapes help implementers apply and validate the terms in metadata records. The terms are intended for use, alongside externally defined terms, in the Health-RI Metadata Schema."@en ;
    dcterms:creator <https://orcid.org/0009-0002-3089-9558>,
        <https://orcid.org/0000-0001-8306-0380>,
        <https://orcid.org/0000-0003-0771-3516>,
        <https://orcid.org/0000-0003-2736-7817> ;
    dcterms:publisher <https://w3id.org/health-ri> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:language "en"^^xsd:language ;
    dcterms:issued "2026-09-30"^^xsd:date ;
    dcterms:modified "2026-10-06"^^xsd:date ;
    owl:priorVersion <https://w3id.org/health-ri/metadata-vocabulary/v0.5.0> ;
    owl:versionInfo "0.6.0" ;
    dcat:version "0.6.0" ;
    owl:versionIRI <https://w3id.org/health-ri/metadata-vocabulary/v0.6.0> ;
    vann:preferredNamespacePrefix "hri" ;
    vann:preferredNamespaceUri "https://w3id.org/health-ri/metadata-vocabulary#"^^xsd:anyURI ;
    foaf:homepage <https://w3id.org/health-ri/metadata-vocabulary/spec> ;
    rdfs:seeAlso <https://w3id.org/health-ri/metadata-vocabulary/v0.6.0/spec> ;
    schema:codeRepository <https://w3id.org/health-ri/metadata-vocabulary/git> ;
    dcat:keyword "health dataset metadata"@en, "dataset discovery"@en, "data catalogues"@en, "health condition of interest"@en, "anatomical coverage"@en ;
    dcterms:bibliographicCitation "Barcelos, P. P. F.; Neikes, H.; Konrad, A.; van Ulzen, N. (2026). Health-RI Metadata Vocabulary, version 0.6.0. https://w3id.org/health-ri/metadata-vocabulary/v0.6.0"@en ;
    rdfs:comment "For each release, the versioned vocabulary Turtle file is the sole normative specification of the Health-RI Metadata Vocabulary. The accompanying examples, SHACL shapes, and generated HTML documentation are non-normative supporting resources. They illustrate usage and provide suggested validation checks; they do not introduce or override vocabulary requirements. In case of discrepancy, the versioned vocabulary Turtle file takes precedence. Development release for review. The entire vocabulary is versioned together using Semantic Versioning; term IRIs remain unversioned. This release does not assert approval or adoption by a particular Health-RI Metadata Schema release."@en .

hri:healthConditionOfInterest a owl:ObjectProperty ;
    rdfs:label "health condition of interest"@en ;
    skos:definition "Relates a dataset to a SNOMED CT, ICD-10, or ORPHAcode concept representing a disease, disorder, or other clinical condition that the dataset concerns as a whole."@en ;
    dcterms:description "Values must be IRIs identifying SNOMED CT, ICD-10, or ORPHAcode concepts and are modelled as skos:Concept in the metadata graph, following the Health-RI Metadata Schema convention. The accompanying non-normative SHACL shape checks IRI-valued objects, skos:Concept typing, and conformity to the SNOMED CT, WHO ICD-10, or ORDO ORPHAcode identifier format. These checks do not verify that the identified concept exists, is active, or represents an appropriate clinical condition. The range declaration does not verify terminology membership."@en ;
    skos:scopeNote "Use this property to describe health conditions of interest in dataset-level metadata and catalogue records. Multiple values may be provided. Select only SNOMED CT, ICD-10, or ORPHAcode concepts that represent diseases, disorders, or other clinical conditions. The relation does not assert that any individual participant has been diagnosed with a condition and is not intended to enumerate diagnoses in individual records."@en ;
    skos:example "A dataset concerning myocardial infarction may use this property with http://snomed.info/id/22298006 (SNOMED CT: Myocardial infarction) as its value. In the metadata graph, the linked resource is typed as skos:Concept. The relation describes the dataset's subject matter without asserting a diagnosis for any individual participant."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/health-ri/metadata-vocabulary> .

hri:anatomicalLocationCovered a owl:ObjectProperty ;
    rdfs:label "anatomical location covered"@en ;
    skos:definition "Relates a dataset to an anatomical class that is Anatomical structure (SNOMED CT 91723000) or one of its subclasses, describing anatomical coverage of the dataset as a whole at metadata or catalogue level."@en ;
    dcterms:description "Values must be SNOMED CT anatomical class IRIs that identify Anatomical structure (91723000) or one of its subclasses. Terminology membership is determined from authoritative SNOMED CT terminology data; using this property does not itself assert or entail an rdfs:subClassOf relationship. The accompanying non-normative SHACL shape checks SNOMED CT IRI syntax and a supplied subclass path to the root when validation is performed with separately trusted SNOMED CT hierarchy evidence. No skos:Concept typing is required for these values."@en ;
    skos:scopeNote "Describes aggregate anatomical coverage of the dataset. Multiple values may be supplied; use is optional (0..*). Values identify anatomical classes, not individual organs, patients, samples, observations, or records. For a dataset combining data categories or modalities, this property does not pair a particular anatomical location with a particular category, modality, or record. For Health-RI Metadata Schema/profile conformance, terminology-binding policy and executable validation belong to the application/profile layer; the provided non-normative validation uses separately trusted SNOMED CT hierarchy evidence and excludes submitted rdfs:subClassOf assertions as authority."@en ;
    skos:example "A dataset covering the lung may link directly to http://snomed.info/id/39607008 (Lung structure) when authoritative SNOMED CT terminology data classifies that concept as http://snomed.info/id/91723000 (Anatomical structure) or one of its subclasses."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:seeAlso sct:91723000 ;
    rdfs:isDefinedBy <https://w3id.org/health-ri/metadata-vocabulary> .

