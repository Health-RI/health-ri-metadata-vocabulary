@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix hri: <https://w3id.org/health-ri/metadata-vocabulary#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Document metadata; the usage data or validation constraints follow below.
<https://w3id.org/health-ri/metadata-vocabulary/shacl> a owl:Ontology ;
    dcterms:title "Health-RI Metadata Vocabulary — application validation shapes"@en ;
    dcterms:description "Suggested SHACL shapes for data using the Health-RI Metadata Vocabulary. Checks Dataset subject typing, IRI-valued objects, and skos:Concept typing for health-condition values. Does not validate clinical appropriateness or authoritative SNOMED CT subclass membership, and is not the complete Health-RI Metadata Schema."@en ;
    dcterms:identifier "https://w3id.org/health-ri/metadata-vocabulary/shacl"^^xsd:anyURI ;
    dcterms:publisher <https://w3id.org/health-ri> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:language "en"^^xsd:language ;
    dcterms:format "text/turtle" ;
    dcterms:modified "2026-10-02"^^xsd:date ;
    dcterms:references <https://w3id.org/health-ri/metadata-vocabulary/v0.2.2> ;
    foaf:primaryTopic <https://w3id.org/health-ri/metadata-vocabulary> ;
    mod:repository <https://w3id.org/health-ri/metadata-vocabulary/git> .

<https://w3id.org/health-ri> a foaf:Organization ;
    foaf:name "Health-RI" ;
    foaf:homepage <https://www.health-ri.nl/> .

# Repeat the vocabulary-to-artifact link so this file explains its association.
<https://w3id.org/health-ri/metadata-vocabulary> sh:suggestedShapesGraph <https://w3id.org/health-ri/metadata-vocabulary/shacl> .

# Application validation, separate from vocabulary entailments.
# Blank-node shapes avoid introducing extra Health-RI vocabulary terms.
[] a sh:NodeShape ;
    sh:targetSubjectsOf hri:healthConditionOfInterest ;
    sh:class dcat:Dataset ;
    sh:property [
        sh:path hri:healthConditionOfInterest ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:message "Health condition of interest must be an IRI identified as a skos:Concept."@en
    ] .

# No minCount or maxCount: optional and repeatable (0..*).
# Validate without loading the vocabulary's domain/range axioms if missing
# explicit data typing must be detected rather than supplied by inference.

# Anatomical subclass semantics are expressed in the vocabulary (OWL Full).
# This shape only checks subject typing and IRI-valued objects, not SNOMED membership.
[] a sh:NodeShape ;
    sh:targetSubjectsOf hri:anatomicalLocationCovered ;
    sh:class dcat:Dataset ;
    sh:property [
        sh:path hri:anatomicalLocationCovered ;
        sh:nodeKind sh:IRI ;
        sh:message "Anatomical location covered must have an IRI-valued object."@en
    ] .
