# Document metadata; the usage data or validation constraints follow below.
<https://w3id.org/health-ri/metadata-vocabulary/example/health-condition-of-interest> a foaf:Document ;
    dcterms:title "Health condition of interest — usage example"@en ;
    dcterms:description "Non-normative usage example demonstrating dataset-level health condition of interest. It does not assert diagnoses of individual participants and is not a complete Health-RI Metadata Schema or HealthDCAT-AP record."@en ;
    dcterms:identifier "https://w3id.org/health-ri/metadata-vocabulary/example/health-condition-of-interest"^^xsd:anyURI ;
    dcterms:publisher <https://w3id.org/health-ri> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:language "en"^^xsd:language ;
    dcterms:format "text/turtle" ;
    dcterms:modified "2026-10-02"^^xsd:date ;
    dcterms:references <https://w3id.org/health-ri/metadata-vocabulary/v0.2.2> ;
    foaf:primaryTopic hri:healthConditionOfInterest ;
    mod:repository <https://w3id.org/health-ri/metadata-vocabulary/git> .

<https://w3id.org/health-ri> a foaf:Organization ;
    foaf:name "Health-RI" ;
    foaf:homepage <https://www.health-ri.nl/> .

# Repeat the vocabulary-to-artifact link so this file explains its association.
<https://w3id.org/health-ri/metadata-vocabulary> vann:example <https://w3id.org/health-ri/metadata-vocabulary/example/health-condition-of-interest> .

<https://example.org/dataset/myocardial-infarction> a dcat:Dataset ;
    dcterms:title "Example dataset concerning myocardial infarction"@en ;
    hri:healthConditionOfInterest <http://snomed.info/id/22298006> .

# Local metadata typing; no redistribution of the external terminology.
<http://snomed.info/id/22298006> a skos:Concept .

